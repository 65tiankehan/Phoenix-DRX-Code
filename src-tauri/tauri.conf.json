{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phoenix-DRX",
  "version": "0.1.8",
  "identifier": "com.phoenix.drx",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Phoenix-DRX",
        "width": 1100,
        "height": 860,
        "center": true,
        "minWidth": 900,
        "minHeight": 640,
        "decorations": false,
        "shadow": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEE1REY0M0M2NUEwNEY3RDAKUldUUTl3UmF4a1BmcFcyMXhBNm8zYXVoUWtjTGJZY2NPRjVQc1dvb3BuOCsvWWwxVlFVWDZqeWYK",
      "endpoints": [
        "https://github.com/65tiankehan/Phoenix-DRX-releases/releases/latest/download/latest.json",
        "https://ghfast.top/https://github.com/65tiankehan/Phoenix-DRX-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
